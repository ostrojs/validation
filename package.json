{
    "name": "@ostro/validation",
    "version": "2.0.0-alpha.3",
    "description": "Validation module for OstroJS",
    "main": "validationManager.js",
    "types": ".typed/validationManager.d.ts",
    "exports": {
        ".": {
            "types": "./.typed/validationManager.d.ts",
            "default": "./validationManager.js"
        },
        "./*": {
            "types": "./.typed/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "build": "npm run lint:check && rm -rf build && ostro-build --prepare",
        "prepublishOnly": "npm run build",
        "test": "jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.3",
        "@ostro/support": "^2.0.0-alpha.3",
        "file-type": "^16.5.1"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "validator",
        "validation"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/validation.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/validation/issues"
    },
    "homepage": "https://github.com/ostrojs/validation#readme",
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    }
}
